DB_URL=jdbc:mysql://localhost:3306/noonco?serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=

# LLM (gemini | fake)
# fake: Gemini 호출 없이 예시 응답 사용 (API 키 불필요, 로컬 개발용)
# gemini: 실제 Gemini 호출 (GEMINI_API_KEY 필수, 서버 배포 시 반드시 gemini)
LLM_PROVIDER=fake
# fake 응답 조각 사이 지연 시간 (fake 일 때만 사용)
LLM_FAKE_CHUNK_DELAY=100ms
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=1.0
GEMINI_MAX_OUTPUT_TOKENS=4096
# 분석 제한 시간: 연결·재시도·폴백·스트림 수신 전체 (예: 120s). 넘으면 AI_TIMEOUT 으로 중단한다
GEMINI_TIMEOUT=60s
# 첫 시도 포함 총 시도 횟수 (1 = 재시도 없음)
GEMINI_RETRY_ATTEMPTS=2
# 기본 모델(GEMINI_MODEL)이 과부하(503)로 실패하면 같은 API 키로 이 예비 모델에 1회 더 요청한다. 비워 두면 폴백하지 않는다
# 할당량 초과(429) 등 다른 오류나, 해설 조각을 받기 시작한 뒤의 실패는 다시 시도하지 않는다
# analysis.model 에는 실제로 응답한 모델 이름이 저장된다
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# 해설 스트림 응답 제한 시간. GEMINI_TIMEOUT(분석 제한 시간)보다 길게 둔다 (같거나 짧으면 서버가 기동하지 않는다)
ASYNC_REQUEST_TIMEOUT=90s
# 해설 스트림 동시 실행 수. 넘으면 AI_BUSY 로 거절한다
AI_MAX_CONCURRENT=3
# 해설 스트림 연결 유지용 ping 전송 간격
STREAM_PING_INTERVAL=3s
# 이미지 요약 해설 최대 길이 (공백 포함 Unicode code point 수, 1 이상). PDF 해설에는 적용하지 않는다
# 목표 길이(300자)는 프롬프트에서 정하고, 이 값은 모델이 목표를 넘겼을 때의 상한이다.
# 넘으면 마지막으로 들어가는 문장까지만 보내고 나머지 요약은 버린다 (상세 해설은 자르지 않는다)
SUMMARY_MAX_LENGTH=350

# CORS 허용 origin (쉼표로 여러 개 지정)
# 서버 예시: CORS_ALLOWED_ORIGINS=https://noonco.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT 서명 키 (32바이트 이상, 예: openssl rand -base64 48 결과). 실제 값은 .env 에만 둔다
JWT_SECRET=
# Access Token 유효 시간
JWT_ACCESS_TOKEN_EXPIRATION=30m
# Refresh Token 유효 시간
JWT_REFRESH_TOKEN_EXPIRATION=14d
# 업로드 파일 저장 폴더 (기본값: 프로젝트 루트의 ./data/files, 없으면 자동 생성)
# 서버 예시: FILE_STORAGE_DIR=/data/noonco/files
FILE_STORAGE_DIR=./data/files
